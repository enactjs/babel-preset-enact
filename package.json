{
  "name": "babel-preset-enact",
  "version": "0.1.17",
  "description": "Babel preset used by Enact",
  "repository": {
    "type": "git",
    "url": "https://github.com/enactjs/babel-preset-enact.git"
  },
  "homepage": "https://github.com/enactjs/babel-preset-enact.git",
  "license": "Apache-2.0",
  "files": [
    "index.js"
  ],
  "scripts": {
    "lint": "eslint .",
    "fix": "eslint . --fix"
  },
  "prettier": {
    "printWidth": 120,
    "useTabs": true,
    "tabWidth": 4,
    "singleQuote": true,
    "bracketSpacing": false,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "quoteProps": "consistent"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-proposal-export-default-from": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/runtime": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "globals": "^17.7.0"
  },
  "devDependencies": {
    "@babel/eslint-plugin": "^8.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.4"
  }
}